# 兼容说明：server 不加载通用 .env；请改用 .env.development.example 或
# .env.production.example，并由系统环境 MEMENTO_ENV 选择运行模式。
# 本文件不含可直接使用的凭据，也不是当前启动模板。

# 运行路径示意。相对路径均基于进程 cwd。
MEMENTO_DB_PATH=./memento.db
MEMENTO_CONFIG_PATH=./memento.production.yaml
MEMENTO_BIND=127.0.0.1:23457
RUST_LOG=info

# 旧站点展示变量已弃用，仅在所选 YAML 首次不存在时作为一次性 seed；
# YAML 文件存在后会被忽略。站点设置应登录 /admin 修改。
MEMENTO_SITE_NAME=
MEMENTO_SLOGAN=
MEMENTO_ICON=
