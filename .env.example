# memento configuration.
# On startup the binary auto-loads a `.env` file from the working directory
# (existing environment variables take precedence). Copy this file to `.env`
# and edit, or export these in your shell.

# Write-auth API key. REQUIRED in production.
# If left unset, the server generates a random ephemeral key at startup and
# logs it ONCE at WARN level. Set a stable value in prod so clients persist.
MEMENTO_API_KEY=change-me-to-a-long-random-secret

# SQLite database file path. Default: ./memento.db
MEMENTO_DB_PATH=./memento.db

# Listen address (host:port). Default: 0.0.0.0:23457
MEMENTO_BIND=0.0.0.0:23457

# Tracing filter. Default: info
RUST_LOG=info

# --- Site display (all optional; shown in the page title, top-bar brand,
# --- hero subtitle and favicon). Each falls back to a built-in default.
# Site name (page title + brand). Default: memento
MEMENTO_SITE_NAME=memento
# Hero slogan / subtitle. Default: 所有的美好都值得被珍藏与分享。
MEMENTO_SLOGAN=所有的美好都值得被珍藏与分享。
# Favicon — a URL or data URI. Default: an inline 🗂️ emoji SVG.
MEMENTO_ICON=
