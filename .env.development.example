# 仅为模板；复制到进程工作目录的 .env.development 后安全填写。
# 必须用系统环境选择模式：MEMENTO_ENV=development cargo run
# 文件内不设置 MEMENTO_ENV，不能靠 dotenv 切换模式。
MEMENTO_BIND=0.0.0.0:23457
MEMENTO_DB_PATH=./memento.dev.db
# 后台功能设置保存在 YAML；相对路径基于进程 cwd。首次缺失时由 server 创建。
MEMENTO_CONFIG_PATH=./memento.development.yaml
MEMENTO_LOGIN_USERNAME=admin
# 用 memento hash-password 生成 bcrypt hash，以单引号包围完整值。
MEMENTO_PASSWORD_HASH=''
# 用 memento totp-secret 生成，并在本地安全配置验证器；禁止提交真实值。
MEMENTO_TOTP_SECRET=''
MEMENTO_SESSION_TTL_DAYS=7
MEMENTO_DIARY_TIMEZONE=Asia/Shanghai
# development 不要求 Origin/Host 比对；仍需密码、TOTP 和登录后 CSRF。
MEMENTO_PUBLIC_ORIGIN=
# 留空禁用外部 key API；需要时安全注入强 key，不从日志获取。
MEMENTO_API_KEY=
RUST_LOG=info
