# 仅为模板；复制到进程工作目录的 .env.production 后安全填写。
# 显式启动：MEMENTO_ENV=production ./memento（未设模式也默认 production）。
MEMENTO_BIND=127.0.0.1:23457
MEMENTO_DB_PATH=./memento.db
# 后台功能设置保存在 YAML；相对路径基于进程 cwd。首次缺失时由 server 创建。
MEMENTO_CONFIG_PATH=./memento.production.yaml
MEMENTO_LOGIN_USERNAME=admin
# 用 memento hash-password 生成 bcrypt hash，以单引号包围完整值。
MEMENTO_PASSWORD_HASH=''
# 用 memento totp-secret 生成并安全配置本地验证器，不提交真实值。
MEMENTO_TOTP_SECRET=''
MEMENTO_SESSION_TTL_DAYS=7
MEMENTO_DIARY_TIMEZONE=Asia/Shanghai
# 必填外部 canonical origin。HTTP 内网 Nginx 示例填写 http://机器IP:8080，
# 如 http://192.168.1.20:8080；无路径/尾斜线/query/fragment/用户信息。
# 可选 HTTPS 示例填写 https://自己的HTTPS名；不填上游 127.0.0.1 地址。
MEMENTO_PUBLIC_ORIGIN=
# 留空禁用外部 key API，不影响已配置的浏览器登录。
MEMENTO_API_KEY=
RUST_LOG=info
